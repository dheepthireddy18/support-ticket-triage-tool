# Copy this file to .env and fill in the values your instructor gave you.
# .env is in .gitignore; never commit it or put a real key in this file.
# One setting per line, no quotes, no spaces around the equals sign.
AZURE_AI_KEY=your-key-here
AZURE_AI_ENDPOINT=your-endpoint-here
AZURE_AI_DEPLOYMENT=your-deployment-name-here

# Optional: TypeSafe's Jev decision model (the jev_urgency rule)
TYPESAFE_API_KEY=your-typesafe-key-here

# Optional: email the daily report (ticket-triage --format pdf --email)
# For Gmail, turn on 2-Step Verification and create an app password (README, "Email the report");
# the normal account password is not accepted. Use the 16 characters without spaces.
# Needs: pip install -e ".[email]"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=you@example.com
REPORT_EMAIL_TO=recipient@example.com
