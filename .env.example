# Copy this file to .env and fill in the values your instructor gave you.
# .env is in .gitignore; never commit it or put a real key in this file.
# One setting per line, no quotes, no spaces around the equals sign.
AZURE_AI_KEY=your-key-here
AZURE_AI_ENDPOINT=your-endpoint-here
AZURE_AI_DEPLOYMENT=your-deployment-name-here
